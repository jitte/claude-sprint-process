#!/bin/bash
# node-vitest / run-test — コンポーネントのディレクトリ（cwd）で vitest を起動する。
# 追加引数（部分実行）はランナーの後ろに付ける。ランナーの JSON は $SPRINT_RAW_DIR/result.json に書く。
# 終了コードは vitest のもの。
set -u
mkdir -p "$SPRINT_RAW_DIR"
exec ./node_modules/.bin/vitest run --reporter=default --reporter=json --outputFile="$SPRINT_RAW_DIR/result.json" "$@"
